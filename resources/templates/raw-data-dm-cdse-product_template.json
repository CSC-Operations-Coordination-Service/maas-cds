{
    "aliases": {
        "raw-data-dm-cdse-product": {}
    },
    "index_patterns": [
        "raw-data-dm-cdse-product-*"
    ],
    "settings": {
        "index": {
            "number_of_shards": 3,
            "number_of_replicas": 1
        }
    },
    "mappings": {
        "_meta": {
            "partition_field": "ingestionTime",
            "partition_format": "%Y"
        },
        "properties": {
            "ingestionTime": {
                "type": "date",
                "format": "date_time",
                "locale": "utc"
            },
            "reportName": {
                "type": "keyword"
            },
            "product_id": {
                "type": "keyword",
                "description": "CDSE OData entity identifier (UUID)"
            },
            "product_name": {
                "type": "keyword"
            },
            "content_length": {
                "type": "long",
                "description": "Product size in bytes"
            },
            "publication_date": {
                "type": "date",
                "format": "date_time",
                "locale": "utc"
            },
            "start_date": {
                "type": "date",
                "format": "date_time",
                "locale": "utc"
            },
            "end_date": {
                "type": "date",
                "format": "date_time",
                "locale": "utc"
            },
            "origin_date": {
                "type": "date",
                "format": "date_time",
                "locale": "utc"
            },
            "modification_date": {
                "type": "date",
                "format": "date_time",
                "locale": "utc"
            },
            "origin_checksum_md5": {
                "type": "keyword"
            },
            "interface_name": {
                "type": "keyword"
            },
            "production_service_type": {
                "type": "keyword"
            },
            "production_service_name": {
                "type": "keyword"
            }
        }
    }
}
