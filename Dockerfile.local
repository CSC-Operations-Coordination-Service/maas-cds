# syntax=docker/dockerfile:1
#
# Mode 1 — "local": install the maas-cds wheel produced by a local or CI build.
# In the pipeline the wheel is handed over via actions/upload-artifact +
# download-artifact (see .github/workflows/maas-cds.yml, job `docker-local`);
# locally just run `tox -e build` first. The `dist/` directory is expected to
# be present in the build context.
#
# Build locally:
#   tox -e build
#   docker build -f Dockerfile.local -t maas-cds:dev \
#     --secret id=pip_index_url,env=PIP_INDEX_URL .
#
ARG PYTHON_VERSION=3.11

FROM python:${PYTHON_VERSION}-slim AS runtime
LABEL Author="Serco - Space unit"

# Don't write .pyc files / buffer stdout (better container logs).
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Bring in the pre-built distribution and install it. maas-model, maas-engine
# and maas-collector are NOT in the context any more (they were sibling
# modules in the monorepo): pip pulls them from the Nexus PyPI index.
#
# `pip_index_url` secret = Nexus PyPI simple index, credential-free, e.g.
#   http://nexus.example.com:8081/repository/pypi-dev-group/simple
# The host is derived from the URL and declared trusted, since the Nexus index
# is served over plain HTTP (pip ignores non-HTTPS indexes otherwise).
# Credentials arrive separately, as a `netrc` secret mounted at /root/.netrc —
# the same split the nexus-context action uses on the runner. BuildKit mounts
# secrets 0400 root-owned, which is what Python's netrc module demands.
#
# Without the secret the build falls back to pip's default index, which is what
# a developer building against a local/proxied index gets.
COPY dist/ /tmp/dist/
RUN --mount=type=secret,id=pip_index_url \
    --mount=type=secret,id=netrc,target=/root/.netrc \
    set -eu; \
    if [ -s /run/secrets/pip_index_url ]; then \
        index_url="$(tr -d '\r\n' < /run/secrets/pip_index_url)"; \
        hostpart="${index_url#*://}"; hostpart="${hostpart%%/*}"; \
        index_host="${hostpart##*@}"; index_host="${index_host%%:*}"; \
        echo "Nexus index host: $index_host"; \
        PIP_INDEX_URL="$index_url"; PIP_TRUSTED_HOST="$index_host"; \
        export PIP_INDEX_URL PIP_TRUSTED_HOST; \
    fi; \
    pip install --no-cache-dir --no-input /tmp/dist/*.whl; \
    rm -rf /tmp/dist

# OpenSearch index templates, consumed by the database initialisation scripts.
COPY resources/ resources/
# Sample engine configuration — mount your own over /conf in production.
COPY conf/cds-engine-conf.json /conf/default-engine.conf

# Create a non-root user and group, and hand over the application files.
RUN groupadd -r appuser && useradd -r -g appuser appuser \
    && chown -R appuser:appuser /app /conf

USER appuser

# Host the health check server binds to, and the port it listens on. Read by
# maas_engine through its --healthcheck-hostname / --healthcheck-port options.
ENV HEALTHCHECK_HOSTNAME=localhost
ENV HEALTHCHECK_PORT=8080

# Health check to ensure the container is running properly. Uses python rather
# than curl: the slim base image ships no curl, and py-healthcheck serves the
# report on "/" (see maas_engine.health.health).
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD python -c 'import os, sys, urllib.request; sys.exit(0 if urllib.request.urlopen("http://" + os.environ["HEALTHCHECK_HOSTNAME"] + ":" + os.environ["HEALTHCHECK_PORT"] + "/", timeout=5).status == 200 else 1)'

VOLUME ["/conf"]

ENTRYPOINT [ "python", "-m"]

CMD ["maas_engine", "-v", "--config", "/conf/default-engine.conf"]
