# Single twine config holding both contexts. URLs only — NO credentials.
# Credentials are injected at runtime via TWINE_USERNAME / TWINE_PASSWORD
# (GitHub secrets), never committed here.
#
# ${NEXUS_HOST} / ${NEXUS_PORT} are placeholders substituted by the
# nexus-context action when it renders this file into $HOME. twine does not
# expand them on its own.
#
# The workflow selects the server by name per context (via TWINE_REPOSITORY):
#   dev  -> nexus-dev
#   prod -> nexus-prod
[distutils]
index-servers =
    nexus-dev
    nexus-prod

[nexus-dev]
repository = http://${NEXUS_HOST}:${NEXUS_PORT}/repository/pypi-dev/

[nexus-prod]
repository = http://${NEXUS_HOST}:${NEXUS_PORT}/repository/pypi-prod/
